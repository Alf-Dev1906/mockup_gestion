APP_NAME="SGE - Sistema de Gestión Estudiantil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------
# BASE DE DATOS — XAMPP/MariaDB Local
# -----------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sge_db
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------
# CACHÉ — Driver: database (desarrollo local)
# En producción cambiar a: redis
# -----------------------------------------
CACHE_STORE=database
CACHE_PREFIX=sge_

# -----------------------------------------
# SESIONES — Driver: database
# -----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------
# COLAS — Driver: database (desarrollo local)
# En producción cambiar a: redis
# -----------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------
# LOG
# -----------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------
# MAIL (desarrollo — log)
# -----------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@universidad.edu.ve"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------
# CORS — Frontend Vue en Vite
# -----------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------
# SANCTUM — API Token Auth
# -----------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173
